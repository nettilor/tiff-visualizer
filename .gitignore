# Virtualenvs (packaging/build_*.sh recreate them)
.venv/
.venv-win/

# PyInstaller output — the app is rebuilt from source
build/
dist/
*.egg-info/

# Generated by packaging/make_icon.py from icon_1024.png when missing
packaging/icon.icns
packaging/icon.ico
packaging/icon.iconset/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Test data: 9 GB of microscopy stacks the regression suite runs against,
# kept locally. See README > Testing.
example_stacks/

# Sessions and scratch output written next to the source during testing
*.tiffviz.json
/*.png
/*.gif
/*.tif

# macOS Finder metadata
.DS_Store
._*

# Editors
.vscode/
.idea/
*.swp

# Claude Code guidance and settings — local, deliberately not published
CLAUDE.md
.claude/
